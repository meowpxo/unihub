# ─── Server ───────────────────────────────
PORT=3000
NODE_ENV=development

# ─── MySQL (update to your XAMPP credentials) ─────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=unihub_db

# ─── JWT ──────────────────────────────────
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_change_this
JWT_REFRESH_EXPIRES_IN=30d

# ─── File Upload ──────────────────────────
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads/pdfs

# ─── Moodle Integration (Module 4) ────────
# Leave blank to use dummy assignments until API access is granted
MOODLE_URL=
MOODLE_TOKEN=

# ─── AI features ──────────────────────────────────
# Provider: "gemini" (free) or "anthropic". Defaults to gemini when a Gemini
# key is set, otherwise anthropic.
AI_PROVIDER=gemini

# Google Gemini — FREE, no credit card. Get a key at https://aistudio.google.com → "Get API key"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Backup models tried in order if the main one is overloaded or unavailable (optional)
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-3.5-flash-lite



PORTAL_URL=http://localhost:4000

# ─── Google Calendar sync ─────────────────────────
# OAuth "Web application" client from console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public HTTPS address of the backend callback (your ngrok domain), e.g.
# https://your-name.ngrok-free.app/api/google/callback
GOOGLE_REDIRECT_URI=
GOOGLE_CALENDAR_TZ=Asia/Kuala_Lumpur

# ─── Forgot password emails (free, via Gmail) ─────
# MAIL_USER = the Gmail address that sends reset codes
# MAIL_PASS = a Gmail App Password (Google Account → Security → 2-Step Verification
#             on → "App passwords"), NOT your normal Gmail password
MAIL_USER=
MAIL_PASS=
